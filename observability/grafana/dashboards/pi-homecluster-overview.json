                    "title": "Open in Node Exporter Full",
                    "url": "/d/rYdddlPWk/node-exporter-full?var-job=node&var-nodename=${__data.fields.HOST}&var-node=${__data.fields.HOST}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "STATUS"
            },
            "properties": [
              {
                "id": "mappings",
