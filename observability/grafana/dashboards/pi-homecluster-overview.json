{
  "uid": "pi-homecluster-overview",
  "title": "Overview",
  "tags": [
    "pi-homecluster",
    "node-exporter"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "links": [
    {
      "title": "Node Exporter Full",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/rYdddlPWk/node-exporter-full",
      "keepTime": true
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "table",
      "title": "SERVERS",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Consolidated view of all nodes. Click a host name to open its Node Exporter Full dashboard.",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (instance, ip) (up{job=\"node\"})",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{job=\"node\",mode=\"idle\"}[$__rate_interval])))",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (1 - sum by (instance) (node_memory_MemAvailable_bytes{job=\"node\"}) / sum by (instance) (node_memory_MemTotal_bytes{job=\"node\"}))",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (1 - max by (instance) (node_filesystem_avail_bytes{job=\"node\",mountpoint=\"/\",fstype!=\"rootfs\"}) / max by (instance) (node_filesystem_size_bytes{job=\"node\",mountpoint=\"/\",fstype!=\"rootfs\"}))",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (instance) (node_thermal_zone_temp{job=\"node\"})",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "8 * sum by (instance) (rate(node_network_receive_bytes_total{job=\"node\",device=~\"eth.*|en.*|wl.*\"}[$__rate_interval]))",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "G",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "8 * sum by (instance) (rate(node_network_transmit_bytes_total{job=\"node\",device=~\"eth.*|en.*|wl.*\"}[$__rate_interval]))",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "H",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (instance) (time() - node_boot_time_seconds{job=\"node\"})",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "I",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (instance) (node_systemd_unit_state{job=\"node\",name=\"cloudflared.service\",state=\"active\"})",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "instance",
            "mode": "outer"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "instance",
                "ip",
                "Value #A",
                "Value #B",
                "Value #C",
                "Value #D",
                "Value #E",
                "Value #F",
                "Value #G",
                "Value #H",
                "Value #I"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "instance": "HOST",
              "ip": "IP",
              "Value #A": "STATUS",
              "Value #B": "CPU",
              "Value #C": "RAM",
              "Value #D": "DISK",
              "Value #E": "TEMPERATURE",
              "Value #F": "NETWORK IN",
              "Value #G": "NETWORK OUT",
              "Value #H": "UPTIME",
              "Value #I": "CLOUDFLARE TUNNEL"
            },
            "indexByName": {
              "instance": 0,
              "ip": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Value #C": 4,
              "Value #D": 5,
              "Value #E": 6,
              "Value #F": 7,
              "Value #G": 8,
              "Value #H": 9,
              "Value #I": 10
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "HOST"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "center",
            "cellOptions": {
              "type": "auto"
            }
          }
